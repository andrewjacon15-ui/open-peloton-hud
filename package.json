{
  "name": "peloton-hud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "tsc -b && oxlint && vitest run",
    "test": "vitest run",
    "verify": "npm run check:secrets && npm run check && npm run build && npm audit --omit=dev --audit-level=high",
    "check:secrets": "node scripts/check-secrets.mjs",
    "publish:public": "node scripts/publish.mjs",
    "bike": "node scripts/bike.mjs",
    "android:build": "node scripts/android.mjs assembleDebug",
    "android:test": "node scripts/android.mjs testDebugUnitTest",
    "android:install": "node scripts/android.mjs installDebug"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
