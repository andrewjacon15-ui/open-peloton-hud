<?xml version="1.0" encoding="utf-8"?>
<!-- Config for BackAccessibilityService. It observes nothing (no event types, no content retrieval) and exists only so the HUD can perform a
     system-wide Back for its overlay's Back button over fullscreen apps like SmartTube. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0"
    android:description="@string/back_accessibility_desc" />
